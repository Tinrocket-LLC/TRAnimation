 <HookInstance>
  <ItemName>touchesBegan</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>445011967</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function touchesBegan(e as NSEventMBS, touches() as NSTouchMBS) As boolean</SourceLine>
   <SourceLine>#Pragma BackgroundTasks True</SourceLine>
   <SourceLine>#Pragma StackOverflowChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma NilObjectChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma BoundsChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If touches.Count = 0 Then Return False</SourceLine>
   <SourceLine>Dim touch As NSTouchMBS = touches(0)</SourceLine>
   <SourceLine>Dim location As NSPointMBS = touch.locationInView(Me.View)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim p As TRVector2D = New TRVector2D(location.X, location.Y)</SourceLine>
   <SourceLine>p = Me.SharedSceneKit.Core.Camera.CurrentWorldTransform.Inverse.ApplyAffineTransform(p)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.SharedSceneKit.Core.HandleEvent_PointerDown(New TRVector2D(location.X, location.Y), p)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Only call .Start in a real pointer event; dont' call in the method version of PointerDown because that's used by the animation system, and calling .Start will break things</SourceLine>
   <SourceLine>Me.SharedSceneKit.Core.Start</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
 </HookInstance>
