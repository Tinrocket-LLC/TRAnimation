 <Method>
  <ItemName>TRAnimationCanvasRendererDelegate_NextFrame</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>153448447</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub TRAnimationCanvasRendererDelegate_NextFrame(sprite as TRAnimationSprite, core as TRAnimationCanvasCore, g as Graphics, currentWorldTransform as TRAffineTransform)</SourceLine>
   <SourceLine>// Part of the TRAnimationCanvasRendererDelegate interface.</SourceLine>
   <SourceLine>#Pragma BackgroundTasks True</SourceLine>
   <SourceLine>#Pragma StackOverflowChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma NilObjectChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma BoundsChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.DrawCounter = Me.DrawCounter + 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim p As TRAnimationSpriteSK</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Not Me.SpritePool.HasKey(sprite) Then</SourceLine>
   <SourceLine>// Create new sprite proxy</SourceLine>
   <SourceLine>If sprite IsA TRAnimationImageSprite Then</SourceLine>
   <SourceLine>p = New TRAnimationImageSpriteSK(sprite)</SourceLine>
   <SourceLine>ElseIf sprite IsA TRAnimationSpriteText Then</SourceLine>
   <SourceLine>p = New TRAnimationSpriteTextSK(sprite)</SourceLine>
   <SourceLine>ElseIf sprite IsA TRAnimationPathSprite Then</SourceLine>
   <SourceLine>p = New TRAnimationPathSpriteSK(sprite)</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If p = Nil Then Return</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.SpritePool.Value(sprite) = p</SourceLine>
   <SourceLine>Me.View.Scene.rootNode.addChildNode(p.Node)</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If p = Nil And Me.SpritePool.HasKey(sprite) Then</SourceLine>
   <SourceLine>p = Me.SpritePool.Value(sprite)</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim scaleFactor As Double = Me.Core.ScaleFactor</SourceLine>
   <SourceLine>p.NextFrame(core, g, currentWorldTransform, scaleFactor, Me.DrawCounter)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>sprite as TRAnimationSprite, core as TRAnimationCanvasCore, g as Graphics, currentWorldTransform as TRAffineTransform</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>TRAnimationCanvasRendererDelegate_PrepareNextFrame</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>876081151</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub TRAnimationCanvasRendererDelegate_PrepareNextFrame(camera as TRAnimationCameraSprite, core as TRAnimationCanvasCore)</SourceLine>
   <SourceLine>// Part of the TRAnimationCanvasRendererDelegate interface.</SourceLine>
   <SourceLine>#Pragma BackgroundTasks True</SourceLine>
   <SourceLine>#Pragma StackOverflowChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma NilObjectChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma BoundsChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.View.stop</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim w As Double = Me.UniversalCanvas.TRAnimationCanvasDelegate_Width</SourceLine>
   <SourceLine>Dim h As Double = Me.UniversalCanvas.TRAnimationCanvasDelegate_Height</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If w &lt; h Then</SourceLine>
   <SourceLine>Me.CameraNode.camera.orthographicScale = Max(w * 0.5, h * 0.5)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Me.CameraNode.camera.orthographicScale = Min(w * 0.5, h * 0.5)</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim t As TRAffineTransform = camera.CurrentWorldTransform</SourceLine>
   <SourceLine>Dim cT As TRVector2D = t.Position</SourceLine>
   <SourceLine>Dim cS As TRVector2D = t.Scale</SourceLine>
   <SourceLine>cS.X = 1.0 / cS.X</SourceLine>
   <SourceLine>cS.Y = 1.0 / cS.Y</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.CameraNode.Position = New SCNVector3MBS((w / 2 - cT.X) * cS.X, (-h / 2 + cT.Y) * cS.Y, 10)</SourceLine>
   <SourceLine>Me.CameraNode.Scale = New SCNVector3MBS(cS.X, cS.Y, 1)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim bgc As Color = Me.UniversalCanvas.TRAnimationCanvasDelegate_BackgroundColor</SourceLine>
   <SourceLine>Me.View.backgroundColor = New NSColorMBS(bgc.Red / 255.0, bgc.Green / 255.0, bgc.Blue / 255.0, 1.0 - (bgc.Alpha / 255.0))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.DrawCounter = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Static lastFrameSeconds As Double = System.Microseconds / 1000000</SourceLine>
   <SourceLine>Dim currentFrameSeconds As Double = System.Microseconds / 1000000</SourceLine>
   <SourceLine>Dim fps As Double = 1.0 / (currentFrameSeconds - lastFrameSeconds)</SourceLine>
   <SourceLine>System.DebugLog(Str(fps))</SourceLine>
   <SourceLine>lastFrameSeconds = currentFrameSeconds</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>camera as TRAnimationCameraSprite, core as TRAnimationCanvasCore</ItemParams>
  <ItemResult></ItemResult>
 </Method>
