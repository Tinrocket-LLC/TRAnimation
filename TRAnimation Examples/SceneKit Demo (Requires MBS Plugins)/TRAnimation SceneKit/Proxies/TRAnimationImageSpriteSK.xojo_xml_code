 <Method>
  <ItemName>NextFrame</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>118896639</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub NextFrame(core as TRAnimationCanvasCore, g as Graphics, currentWorldTransform as TRAffineTransform, scaleFactor as Double, drawCount as Integer)</SourceLine>
   <SourceLine>#Pragma BackgroundTasks True</SourceLine>
   <SourceLine>#Pragma StackOverflowChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma NilObjectChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma BoundsChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim s As TRAnimationImageSprite = TRAnimationImageSprite(Me.Sprite)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If s.Sprite &lt;&gt; Nil Then</SourceLine>
   <SourceLine>If s.Sprite &lt;&gt; Me.LastSprite Or s.Sprite.Width &lt;&gt; Me.LastSize.X Or s.Sprite.Height &lt;&gt; Me.LastSize.Y Then</SourceLine>
   <SourceLine>Me.LastSize.Set(s.Sprite.Width, s.Sprite.Height)</SourceLine>
   <SourceLine>Me.LastSprite = s.Sprite</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim plane As SCNPlaneMBS = Me.Plane</SourceLine>
   <SourceLine>plane.width = Me.LastSize.X</SourceLine>
   <SourceLine>plane.height = Me.LastSize.Y</SourceLine>
   <SourceLine>plane.firstMaterial.diffuse.contents = s.Sprite</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Me.Node.pivot = SCNMatrix4MBS.Translation(s.Center.X, s.Center.Y, 0)</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Super.NextFrame(core, g, currentWorldTransform, scaleFactor, drawCount)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If s IsA TRAnimationTintedImageSprite Then</SourceLine>
   <SourceLine>Dim c As Color = TRAnimationTintedImageSprite(s).TintColor</SourceLine>
   <SourceLine>Me.Node.Geometry.firstMaterial.multiply.contents = NSColorMBS.colorWithRGB(c.Red / 255.0, c.Green / 255.0, c.Blue / 255.0, 1.0 - c.Alpha / 255.0)</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf s.Sprite = Nil Then</SourceLine>
   <SourceLine>// "Invisible"</SourceLine>
   <SourceLine>plane.width = 0</SourceLine>
   <SourceLine>plane.height = 0</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
