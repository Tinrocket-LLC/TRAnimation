 <Method>
  <ItemName>NextFrame</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>348131327</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub NextFrame(core as TRAnimationCanvasCore, g as Graphics, currentWorldTransform as TRAffineTransform, scaleFactor as Double, drawCount as Integer)</SourceLine>
   <SourceLine>#Pragma BackgroundTasks True</SourceLine>
   <SourceLine>#Pragma StackOverflowChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma NilObjectChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma BoundsChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Me.Node.Geometry = Nil Then Return</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.Node.Hidden = Me.Sprite.Hidden</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim sT As TRVector2D = currentWorldTransform.Position</SourceLine>
   <SourceLine>Dim sS As TRVector2D = currentWorldTransform.Scale</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.Node.Position = New SCNVector3MBS(sT.X, -sT.Y, drawCount * 0.1) // drawCount is converted to depth for correct overlap</SourceLine>
   <SourceLine>Me.Node.Scale = New SCNVector3MBS(sS.X, sS.Y, 1)</SourceLine>
   <SourceLine>Me.Node.Rotation = New SCNVector4MBS(0, 0, 1, -Me.Sprite.RotationAsDegrees * TRMath.kRadian)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.Node.Geometry.firstMaterial.transparency = 1.0 - (g.Transparency / 100.0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>core as TRAnimationCanvasCore, g as Graphics, currentWorldTransform as TRAffineTransform, scaleFactor as Double, drawCount as Integer</ItemParams>
  <ItemResult></ItemResult>
 </Method>
