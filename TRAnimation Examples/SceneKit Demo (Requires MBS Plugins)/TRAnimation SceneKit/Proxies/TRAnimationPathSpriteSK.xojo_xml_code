 <Method>
  <ItemName>NextFrame</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1765003263</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub NextFrame(core as TRAnimationCanvasCore, g as Graphics, currentWorldTransform as TRAffineTransform, scaleFactor as Double, drawCount as Integer)</SourceLine>
   <SourceLine>#Pragma BackgroundTasks True</SourceLine>
   <SourceLine>#Pragma StackOverflowChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma NilObjectChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine>#Pragma BoundsChecking TRAnimation.kSafeMode</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim s As TRAnimationPathSprite = TRAnimationPathSprite(Me.Sprite)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Me.Node.Hidden = False</SourceLine>
   <SourceLine>If s.Path = Nil Then</SourceLine>
   <SourceLine>Me.Node.Hidden = True</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim p As Picture = s.ToPicture(s.RenderBuffer, scaleFactor, core) // Render buffer will keep being reused and will automaticall grow (but not shrink)</SourceLine>
   <SourceLine>s.RenderBuffer = p</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim plane As SCNPlaneMBS = Me.Plane</SourceLine>
   <SourceLine>plane.width = p.Width / scaleFactor</SourceLine>
   <SourceLine>plane.height = p.Height / scaleFactor</SourceLine>
   <SourceLine>plane.firstMaterial.diffuse.contents = s.RenderBuffer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Must move half of plane height and width to orient to upper left corner, then add offsets</SourceLine>
   <SourceLine>Me.Node.pivot = SCNMatrix4MBS.Translation(-plane.width / 2 + s.RenderBufferOffset.X, plane.height / 2 - s.RenderBufferOffset.Y, 0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Super.NextFrame(core, g, currentWorldTransform, scaleFactor, drawCount)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
